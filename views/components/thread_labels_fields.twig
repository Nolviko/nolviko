{# Prefix and tag fields (2026-11-08) for the create-thread and thread-labels forms. Context: prefix_options (id,
   label, class), tag_options (id, name, slug), selected_prefix (id or null), selected_tags (list of ids),
   max_tags, prefix_required (2026-11-27: a new thread needs a prefix; the "no prefix" choice is gone). Nothing is
   shown when the administrator has defined neither. A long tag list gets a search box (tag-filter.js). #}
{% if prefix_options is not empty %}
{% set required = prefix_required|default(false) %}
<p><label for="thread-prefix">{{ t('threads.labels.prefix') }}{% if required %} <span class="meta">{{ t('threads.labels.prefix_required') }}</span>{% endif %}</label>
<select id="thread-prefix" name="prefix"{% if required %} required{% endif %}><option value="">{{ required ? t('threads.labels.choose_prefix') : t('threads.labels.no_prefix') }}</option>
{% for prefix in prefix_options %}<option value="{{ prefix.id }}"{% if prefix.id == selected_prefix %} selected{% endif %}>{{ prefix.label }}</option>{% endfor %}
</select></p>
{% endif %}
{% if tag_options is not empty %}
<fieldset class="tag-picks">
<legend>{{ t('threads.labels.tags', {max: max_tags}) }}</legend>
{% if tag_options|length > 12 %}<p><input type="search" data-tag-filter hidden placeholder="{{ t('threads.labels.tag_search') }}" aria-label="{{ t('threads.labels.tag_search') }}"></p>
<script src="{{ asset('tag-filter.js') }}" defer></script>{% endif %}
<div class="tag-picks-list">
{% for tag in tag_options %}<span><input id="tag-{{ tag.id }}" name="tags[]" type="checkbox" value="{{ tag.id }}"{% if tag.id in selected_tags %} checked{% endif %}> <label for="tag-{{ tag.id }}"><bdi>{{ tag.name }}</bdi></label></span>
{% endfor %}
</div>
</fieldset>
{% endif %}
