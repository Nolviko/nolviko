{# BBCode formatting toolbar (design pass 2026-11-07; ADR-030 progressive enhancement). Include right before a
   textarea: {% include 'components/editor_toolbar.twig' with {target: 'textarea-id'} %}. Hidden until editor.js
   runs, so without JavaScript the plain textarea and BBCode typed by hand keep working. Buttons only insert text;
   the server still parses and sanitizes every tag (BbcodeRenderer). 2026-11-08: an emoji picker and a
   BBCode/Markdown choice (Markdown is converted to BBCode on submit, MarkdownToBbcode). 2026-11-09: optional
   `image_upload` {url, token, max}: an "Add image" button that uploads into the member's gallery and inserts [img]
   (only while post images are on; max = images per post, enforced on the server too). #}
{% set tools = [
    {tag: 'b', label: t('core.editor.bold'), key: 'b'},
    {tag: 'i', label: t('core.editor.italic'), key: 'i'},
    {tag: 'u', label: t('core.editor.underline'), key: 'u'},
    {tag: 's', label: t('core.editor.strike'), key: ''},
    {tag: 'url', label: t('core.editor.link'), key: 'k'},
    {tag: 'quote', label: t('core.editor.quote'), key: ''},
    {tag: 'code', label: t('core.editor.code'), key: ''},
    {tag: 'list', label: t('core.editor.list'), key: ''},
    {tag: 'spoiler', label: t('core.editor.spoiler'), key: ''},
] %}
<span class="editor-bar" role="toolbar" aria-label="{{ t('core.editor.label') }}" aria-controls="{{ target }}" data-editor="{{ target }}" hidden>
{% for tool in tools %}<button type="button" class="editor-btn" data-bb="{{ tool.tag }}"{% if tool.key %} data-key="{{ tool.key }}" aria-keyshortcuts="Control+{{ tool.key|upper }}"{% endif %} aria-label="{{ tool.label }}" title="{{ tool.label }}"{% if not loop.first %} tabindex="-1"{% endif %}><svg class="ic" viewBox="0 0 24 24" aria-hidden="true">
{%- if tool.tag == 'b' %}<path d="M7 5h6a3.5 3.5 0 0 1 0 7H7zM7 12h7a3.5 3.5 0 0 1 0 7H7z"></path>
{%- elseif tool.tag == 'i' %}<path d="M14 5h-4M14 19h-4M14 5l-4 14"></path>
{%- elseif tool.tag == 'u' %}<path d="M7 5v6a5 5 0 0 0 10 0V5M5 20h14"></path>
{%- elseif tool.tag == 's' %}<path d="M5 12h14M16 7a4 3 0 0 0-8 0c0 4 8 3 8 7a4 3 0 0 1-8 0"></path>
{%- elseif tool.tag == 'url' %}<path d="M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1 1M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1-1"></path>
{%- elseif tool.tag == 'quote' %}<path d="M6 17h4v-5H6l2-5M14 17h4v-5h-4l2-5"></path>
{%- elseif tool.tag == 'code' %}<path d="m9 8-4 4 4 4M15 8l4 4-4 4"></path>
{%- elseif tool.tag == 'list' %}<path d="M9 6h11M9 12h11M9 18h11M5 6h.01M5 12h.01M5 18h.01"></path>
{%- else %}<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"></path><path d="M4 4l16 16"></path>
{%- endif %}</svg></button>{% endfor %}
<button type="button" class="editor-btn" data-emoji-toggle aria-expanded="false" aria-label="{{ t('core.editor.emoji') }}" title="{{ t('core.editor.emoji') }}" tabindex="-1"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path></svg></button>
{% if image_upload|default(null) %}<button type="button" class="editor-btn" data-image-upload="{{ image_upload.url }}" data-token="{{ image_upload.token }}" data-busy="{{ t('core.editor.image_busy') }}" data-max="{{ image_upload.max }}" data-full="{{ t('core.editor.image_full', {max: image_upload.max}) }}" aria-label="{{ t('core.editor.image') }}" title="{{ t('core.editor.image') }}" tabindex="-1"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="m4 18 5-5 4 4 3-3 4 4"></path></svg></button><span class="editor-status" role="status" aria-live="polite"></span>{% endif %}
<span class="editor-format"><label>{{ t('core.editor.format') }} <select name="format"><option value="{{ 'bbcode' }}">{{ 'BBCode' }}</option><option value="{{ 'markdown' }}">{{ 'Markdown' }}</option></select></label></span>
</span>
<script src="{{ asset('editor.js') }}" defer></script>
