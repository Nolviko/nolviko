{# Ask for a password reset link (M02.05). Context: title, action, csrf_field, csrf_token, sent, error
   (translated or null), login_url. The answer is the same for every address. #}
{% extends 'layouts/page.twig' %}

{% block main_class %}{{ 'main-auth' }}{% endblock %}

{% block content %}
<h1>{{ title }}</h1>
{% if error %}
<p role="alert">{{ error }}</p>
{% elseif sent %}
<p role="status">{{ t('auth.forgot.sent') }}</p>
{% endif %}
<p>{{ t('auth.forgot.intro') }}</p>
<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<p><label for="forgot-email">{{ t('auth.register.email') }}</label>
<input id="forgot-email" name="email" type="email" required autocomplete="email" maxlength="254"></p>
<p><button type="submit">{{ t('auth.forgot.submit') }}</button></p>
</form>
<p><a href="{{ login_url|safe_url }}">{{ t('auth.register.to_login') }}</a></p>
{% endblock %}
