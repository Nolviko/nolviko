{# Choose a new password (M02.05). Context: title, state (form, done or invalid), token, errors (translated),
   action, csrf_field, csrf_token, password_min, forgot_url, login_url. #}
{% extends 'layouts/page.twig' %}

{% block main_class %}{{ 'main-auth' }}{% endblock %}

{% block content %}
<h1>{{ title }}</h1>
{% if state == 'form' %}
{% if errors is not empty %}
<div role="alert">
<ul>
{% for error in errors %}
<li>{{ error }}</li>
{% endfor %}
</ul>
</div>
{% endif %}
<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="token" value="{{ token }}">
<p><label for="reset-password">{{ t('auth.register.password', {min: password_min}) }}</label>
<input id="reset-password" name="password" type="password" required autocomplete="new-password" minlength="{{ password_min }}"></p>
<p><label for="reset-confirmation">{{ t('auth.register.confirmation') }}</label>
<input id="reset-confirmation" name="password_confirmation" type="password" required autocomplete="new-password"></p>
<p><button type="submit">{{ t('auth.reset.submit') }}</button></p>
</form>
{% elseif state == 'done' %}
<p role="status">{{ t('auth.reset.done') }}</p>
<p><a href="{{ login_url|safe_url }}">{{ t('auth.register.to_login') }}</a></p>
{% else %}
<p role="alert">{{ t('auth.reset.invalid') }}</p>
<p><a href="{{ forgot_url|safe_url }}">{{ t('auth.reset.request_new') }}</a></p>
{% endif %}
{% endblock %}
