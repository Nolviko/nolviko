{% extends 'admin/layout.twig' %}
{% block admin %}
<p>{{ t('admin.extensions.intro') }}</p>
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if installed|default(null) %}<p role="status">{{ t('admin.extensions.installed_notice', {name: installed.name, version: installed.version}) }}{% if installed.settings_url %} <a href="{{ installed.settings_url|safe_url }}">{{ t('admin.extensions.settings') }}</a>{% endif %}</p>{% endif %}
{% if safe %}<p role="status">{{ t('admin.extensions.safe_active') }}</p>{% endif %}
{% if not fresh %}<p><a href="{{ reauth_url|safe_url }}">{{ t('admin.extensions.reauth') }}</a></p>{% endif %}
{% if diagnostics %}<h2>{{ t('admin.extensions.diagnostics') }}</h2><ul>
{% for id, diagnostic in diagnostics %}<li><code>{{ id }}</code>: <code>{{ diagnostic }}</code></li>{% endfor %}
</ul>{% endif %}
{% if fresh %}
<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="action" value="{% if safe %}{{ actions.resume }}{% else %}{{ actions.safe }}{% endif %}">
<p><label><input type="checkbox" name="confirm" value="1" required> {{ t('admin.extensions.confirm') }}</label></p>
<button type="submit">{% if safe %}{{ t('admin.extensions.resume') }}{% else %}{{ t('admin.extensions.safe') }}{% endif %}</button>
</form>
<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}"><input type="hidden" name="action" value="{{ actions.disable_all }}">
<p><label><input type="checkbox" name="confirm" value="1" required> {{ t('admin.extensions.confirm') }}</label></p>
<button type="submit">{{ t('admin.extensions.disable_all') }}</button></form>
{% endif %}
<h2>{{ t('admin.extensions.installed') }}</h2>
{% for extension in extensions %}
<section><h3>{{ extension.name }}</h3><p><code>{{ extension.id }}</code> {{ extension.version }}</p>
<p>{% if extension.enabled %}{{ t('admin.extensions.enabled') }}{% else %}{{ t('admin.extensions.disabled') }}{% endif %}
{% if extension.settings_url|default(null) %} · <a href="{{ extension.settings_url|safe_url }}">{{ t('admin.extensions.settings') }}</a>{% endif %}</p>
{% if fresh %}<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="id" value="{{ extension.id }}">
<input type="hidden" name="action" value="{% if extension.enabled %}{{ actions.disable }}{% else %}{{ actions.enable }}{% endif %}">
<p><label><input type="checkbox" name="confirm" value="1" required> {{ t('admin.extensions.confirm') }}</label></p>
<button type="submit">{% if extension.enabled %}{{ t('admin.extensions.disable') }}{% else %}{{ t('admin.extensions.enable') }}{% endif %}</button>
</form>{% endif %}</section>
{% else %}<p class="admin-empty">{{ t('admin.extensions.empty') }}</p>{% endfor %}
{% if fresh %}
<h2>{{ t('admin.extensions.upload_heading') }}</h2>
<form method="post" action="{{ action|safe_url }}" enctype="multipart/form-data" data-admin-progress data-dropzone>
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}"><input type="hidden" name="action" value="{{ actions.upload }}">
<p><label><input type="checkbox" name="confirm" value="1" required> {{ t('admin.extensions.upload_confirm') }}</label></p>
<label class="dropzone" for="extension-package"><strong>{{ t('admin.extensions.upload_drop') }}</strong>
<span class="hint">{{ t('admin.extensions.upload_hint') }}</span>
<input id="extension-package" type="file" name="package" accept=".zip,application/zip" required></label>
<p><button type="submit">{{ t('admin.extensions.upload_submit') }}</button>
<span class="hint" data-submit-status hidden>{{ t('admin.extensions.uploading') }}</span></p>
</form>
{% endif %}
{% endblock %}
