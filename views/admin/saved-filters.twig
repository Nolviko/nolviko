{% extends 'admin/layout.twig' %}
{% block admin %}
<p>{{ t('admin.saved.intro') }}</p>
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if notice %}<p role="status">{{ notice }}</p>{% endif %}
<form method="get" action="{{ action|safe_url }}" data-admin-progress>
<p><label for="saved-context">{{ t('admin.saved.context') }}</label>
<select id="saved-context" name="context">{% for item in contexts %}
<option value="{{ item.id }}"{% if item.id == context %} selected{% endif %}>{{ item.label }}</option>
{% endfor %}</select></p>
<button type="submit">{{ t('admin.saved.choose') }}</button>
<p role="status" data-submit-status hidden>{{ t('admin.progress.loading') }}</p>
</form>
<h2>{{ t('admin.saved.create') }}</h2>
<form method="post" action="{{ action|safe_url }}" data-admin-progress>
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="context" value="{{ context }}">
<p><label for="saved-name">{{ t('admin.saved.name') }}</label>
<input id="saved-name" name="name" maxlength="80" value="{{ name }}" required></p>
{% for field in fields %}
<p><label for="saved-field-{{ field.key }}">{{ field.label }}</label>
{% if field.options is not empty %}
<select id="saved-field-{{ field.key }}" name="f[{{ field.key }}]">
<option value="">{{ t('admin.saved.any') }}</option>
{% for option in field.options %}
<option value="{{ option.value }}"{% if option.value == field.value %} selected{% endif %}>{{ option.label }}</option>
{% endfor %}</select>
{% else %}<input id="saved-field-{{ field.key }}" name="f[{{ field.key }}]" maxlength="120" value="{{ field.value }}">{% endif %}</p>
{% endfor %}
<button type="submit" name="action" value="{{ actions.save }}">{{ t('admin.saved.save') }}</button>
<p role="status" data-submit-status hidden>{{ t('admin.progress.loading') }}</p>
</form>
<h2>{{ t('admin.saved.list') }}</h2>
{% if rows is empty and not error %}<p class="admin-empty">{{ t('admin.saved.empty') }}</p>{% endif %}
<ul>{% for row in rows %}<li>
{% if row.url is not null %}<a href="{{ row.url|safe_url }}"><bdi>{{ row.name }}</bdi></a>
{% else %}<bdi>{{ row.name }}</bdi> — {{ t('admin.saved.corrupt') }}{% endif %}
<form method="post" action="{{ action|safe_url }}" data-admin-progress>
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="context" value="{{ context }}">
<input type="hidden" name="id" value="{{ row.id }}">
<button class="btn-d" type="submit" name="action" value="{{ actions.delete }}">{{ t('admin.saved.delete', {name: row.name}) }}</button>
<p role="status" data-submit-status hidden>{{ t('admin.progress.loading') }}</p>
</form></li>{% endfor %}</ul>
{% endblock %}
