{% extends 'admin/layout.twig' %}

{% block admin %}
{% if notice|default(null) %}<p role="status">{{ notice }}</p>{% endif %}
{% if problems|default([]) is not empty %}<div class="panel" role="alert"><p><strong>{{ t('operations.problems_heading') }}</strong></p>
<ul>{% for problem in problems %}<li>{{ t(problem) }}</li>{% endfor %}</ul>
{% if problem_codes|default([]) is not empty %}<p class="hint">{{ t('operations.problem_codes', {codes: problem_codes|join(', ')}) }}</p>{% endif %}</div>{% endif %}
{% if configured|default(false) %}
<p>{{ t('operations.notify_policy') }}</p>
<p>{{ t('operations.update_storage') }}</p>
<form method="post" action="{{ post_url|safe_url }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
<button name="action" value="{{ 'check_releases' }}">{{ t('operations.check') }}</button></form>
<div class="panel" data-update-driver hidden data-url="{{ post_url|safe_url }}" data-recovery="{{ recovery_url|safe_url }}"
 data-csrf-field="{{ '_csrf_token' }}" data-csrf="{{ csrf_token }}" data-job="{{ has_job|default(false) ? 1 : 0 }}"
 data-text="{{ {download: t('operations.progress_download'), stage: t('operations.progress_stage'), copy: t('operations.progress_copy'), recovery_backup: t('operations.progress_backup'), recovery_resume: t('operations.progress_switch'), recovery_migrate: t('operations.progress_migrate'), recovery_smoke: t('operations.progress_check'), recovery_finish: t('operations.progress_finish'), done: t('operations.progress_done'), cancelled: t('operations.progress_cancelled'), retry: t('operations.progress_retry'), failed: t('operations.progress_failed'), continue: t('operations.continue_update'), code: t('operations.problem_codes', {codes: ''})}|json_encode|e('html_attr') }}">
<p>{{ t('operations.one_click_help') }}</p>
<p><button type="button" data-update-start>{{ has_job|default(false) ? t('operations.continue_update') : t('operations.update_now') }}</button></p>
<progress hidden></progress>
<p data-update-status role="status" aria-live="polite"></p>
<ul data-update-problems role="alert" hidden></ul>
<dialog data-update-password data-url="{{ reauth_url|safe_url }}">
<form method="dialog">
<h2>{{ t('operations.password_title') }}</h2>
<p>{{ t('operations.password_help') }}</p>
<p><label>{{ t('admin.reauth.password') }} <input type="password" name="password" autocomplete="current-password" required></label></p>
<p data-update-code-field hidden><label>{{ t('operations.password_code') }} <input name="code" inputmode="numeric" autocomplete="one-time-code"></label></p>
<p role="alert" data-update-password-error hidden></p>
<p><button value="{{ 'confirm' }}">{{ t('operations.password_confirm') }}</button> <button value="{{ 'cancel' }}" formnovalidate>{{ t('operations.password_cancel') }}</button></p>
</form>
</dialog>
<details data-update-code hidden><summary>{{ t('operations.code_fallback') }}</summary>
<p>{{ t('operations.code_fallback_help') }}</p><p><a href="{{ recovery_url|safe_url }}">{{ t('admin.recovery.open') }}</a></p><p><code></code></p></details>
</div>
<script src="{{ asset('admin-update.js') }}" defer></script>
<details><summary>{{ t('operations.manual_steps') }}</summary>
{% if has_job|default(false) %}
<form method="post" action="{{ post_url|safe_url }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
<button name="action" value="{{ 'stage_release' }}">{{ t('operations.stage') }}</button>
<button name="action" value="{{ 'abandon_release' }}">{{ t('operations.abandon') }}</button></form>
{% else %}
<h2>{{ t('operations.download_heading') }}</h2>
<p>{{ t('operations.download_help') }}</p>
<form method="post" action="{{ post_url|safe_url }}" data-admin-progress>
<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
<p><label><input type="checkbox" name="confirmed" value="1" required> {{ t('operations.confirm') }}</label></p>
<button name="action" value="{{ 'download_release' }}">{{ t('operations.download') }}</button>
<span class="hint" data-submit-status hidden>{{ t('operations.downloading') }}</span></form>
<details><summary>{{ t('operations.manual_upload') }}</summary>
<form method="post" action="{{ post_url|safe_url }}" enctype="multipart/form-data">
<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
<p><label>{{ t('operations.archive') }} <input type="file" name="archive" accept=".zip" required></label></p>
<p><label>{{ t('operations.manifest') }} <input type="file" name="manifest" accept=".json" required></label></p>
<p><label>{{ t('operations.signature') }} <input type="file" name="signature" accept=".sig,.txt" required></label></p>
<p><label><input type="checkbox" name="confirmed" value="1" required> {{ t('operations.confirm') }}</label></p>
<button name="action" value="{{ 'upload_release' }}">{{ t('operations.upload') }}</button></form></details>
{% endif %}
</details>
{% else %}<p>{{ t('operations.setup') }}</p>{% endif %}

{% if runs is null %}
<p role="alert">{{ t('admin.updates.error') }}</p>
{% elseif runs is empty %}
<p class="admin-empty">{{ t('admin.updates.empty') }}</p>
{% else %}
<table>
<caption>{{ t('admin.updates.history') }}</caption>
<thead><tr>
<th scope="col">{{ t('admin.updates.release') }}</th>
<th scope="col">{{ t('admin.updates.stage') }}</th>
<th scope="col">{{ t('admin.updates.state') }}</th>
<th scope="col">{{ t('admin.updates.step') }}</th>
<th scope="col">{{ t('admin.updates.updated') }}</th>

</tr></thead>
<tbody>
{% for run in runs %}
<tr>
<th scope="row">{{ run.target }}</th>
<td>{{ t(run.stage) }}</td><td>{{ t(run.state) }}</td>
<td>{{ run.cursor|format_number }}</td><td>{{ run.updated }}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% endif %}
<details><summary>{{ t('operations.manual_steps') }}</summary>
<h2>{{ t('admin.updates.preparation') }}</h2>
{% if prepare_error %}<p role="alert">{{ t(prepare_error) }}</p>{% endif %}
{% if prepared %}
<p role="status">{{ t('admin.updates.prepared_count') }} {{ prepared.progress.copied|format_number }} / {{ prepared.progress.total|format_number }}</p>
{% if prepared.grant %}
<p>{{ t('admin.updates.code_notice') }}</p>
<p><a href="{{ recovery_url|safe_url }}">{{ t('admin.recovery.open') }}</a></p>
<label for="recovery-code">{{ t('admin.updates.recovery_code') }}</label>
<textarea id="recovery-code" readonly autocomplete="off" spellcheck="false">{{ prepared.grant.id }}.{{ prepared.grant.code }}.{{ prepared.grant.nonce }}</textarea>
{% endif %}
{% endif %}
{% if prepare_available %}
<form method="post" action="{{ post_url|safe_url }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
<input type="hidden" name="action" value="prepare_recovery"> {# i18n-ignore: protocol value; visible label is translated. #}
<button type="submit">{{ t('admin.updates.prepare') }}</button>
</form>
{% else %}
<p><a href="{{ reauth_url|safe_url }}">{{ t('admin.updates.confirm_first') }}</a></p>
{% endif %}
<h2>{{ t('admin.updates.manual') }}</h2>
<ol>
<li>{{ t('admin.updates.backup') }}</li>
<li>{{ t('admin.updates.close') }}</li>
<li>{{ t('admin.updates.restore') }}</li>
<li>{{ t('admin.updates.open') }}</li>
</ol>
<p>{{ t('admin.updates.pending') }}</p>
</details>
{% endblock %}
