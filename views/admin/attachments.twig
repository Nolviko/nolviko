{# Attachment inventory (beta.18 roadmap 15, 16). Context: title, nav, action, page (rows, next, count, bytes,
   orphans), type, types, allowed, max_mb, next_url, settings_url, error, fresh, reauth_url, csrf_field, csrf_token. #}
{% extends 'admin/layout.twig' %}

{% block admin %}
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
<p>{{ t('content.attachments.policy', {types: allowed, mb: max_mb}) }} <a href="{{ settings_url|safe_url }}">{{ t('content.attachments.change') }}</a></p>
<p class="meta">{{ t('content.attachments.totals', {count: page.count, mb: (page.bytes / 1048576)|round(1), orphans: page.orphans}) }}</p>
{% if not fresh %}<p><a href="{{ reauth_url|safe_url }}">{{ t('admin.site.reauth') }}</a></p>{% endif %}
<form method="get" action="{{ action|safe_url }}"><label for="att-type">{{ t('content.attachments.type') }}</label>
<select id="att-type" name="type"><option value="">{{ t('content.attachments.all') }}</option>{% for option in types %}<option value="{{ option }}"{% if option == type %} selected{% endif %}>{{ option }}</option>{% endfor %}</select>
<button class="btn-s" type="submit">{{ t('content.attachments.filter') }}</button></form>
{% if page.rows is empty %}<p class="hint">{{ t('content.attachments.none') }}</p>{% else %}
<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<table class="table"><thead><tr><th scope="col"><span class="visually-hidden">{{ t('content.attachments.select') }}</span></th><th scope="col">{{ t('content.attachments.name') }}</th><th scope="col">{{ t('content.attachments.type') }}</th><th scope="col">{{ t('content.attachments.size') }}</th><th scope="col">{{ t('content.attachments.owner') }}</th><th scope="col">{{ t('content.attachments.post') }}</th><th scope="col">{{ t('content.attachments.date') }}</th></tr></thead>
<tbody>{% for row in page.rows %}<tr><td><input type="checkbox" name="media[]" value="{{ row.id }}" aria-label="{{ t('content.attachments.select_file', {name: row.name}) }}"></td>
<td><bdi>{{ row.name }}</bdi></td><td>{{ row.mime }}</td><td>{{ t('content.attachments.kb', {kb: (row.bytes / 1024)|round}) }}</td>
<td>{% if row.user %}<bdi>{{ row.user }}</bdi>{% else %}—{% endif %}</td>
<td>{% if row.post_id %}<a href="{{ path('posts.show', {post: row.post_id})|safe_url }}">#{{ row.post_id }}</a>{% else %}{{ t('content.attachments.unattached') }}{% endif %}</td>
<td>{{ row.created_at }}</td></tr>{% endfor %}</tbody></table>
<p><button class="btn-d" type="submit"{% if not fresh %} disabled{% endif %}>{{ t('content.attachments.remove') }}</button></p>
</form>
{% if next_url %}<p><a href="{{ next_url|safe_url }}">{{ t('content.attachments.older') }}</a></p>{% endif %}
{% endif %}
{% endblock %}
