{% extends 'admin/layout.twig' %}
{% block admin %}
<p>{{ t('operations.importer_intro') }}</p>
<p><a class="btn" href="{{ extensions_url|safe_url }}">{{ t('operations.importer_install') }}</a></p>
{% if recent is not empty %}
<h2>{{ t('operations.recent') }}</h2>
<ul>{% for job in recent %}<li>{{ job.engine }} {{ job.source_version }} — {{ job.published_at ? t('operations.published') : (job.state == 'completed' ? t('operations.completed') : t('operations.importer_unfinished')) }}</li>{% endfor %}</ul>
{% endif %}
{% endblock %}
