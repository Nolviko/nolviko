{% extends 'admin/layout.twig' %}
{% block admin %}
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if notice %}<p role="status">{{ notice }}</p>{% endif %}
<p>{{ t('operations.import_policy') }}</p>

{% if selected %}
<h2>{{ t('operations.progress') }}</h2>
<dl><dt>{{ t('operations.processed') }}</dt><dd>{{ selected.processed|format_number }}</dd>
<dt>{{ t('operations.verified') }}</dt><dd>{{ selected.verified|format_number }}</dd></dl>
{% if selected.state == 'completed' %}<p role="status">{{ t('operations.completed') }}</p>{% else %}
<p>{{ t('operations.run_auto') }}</p>
<p data-import-status role="status" aria-live="polite" hidden data-running="{{ t('operations.running') }}"
   data-paused="{{ t('operations.run_paused') }}" data-done="{{ t('operations.run_done') }}"></p>
<form method="post" action="{{ action|safe_url }}" data-import-run data-import-done="{{ job_url|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="job" value="{{ selected.id }}">
<input type="hidden" name="revision" value="{{ selected.revision }}">
<button name="action" value="{{ 'step' }}">{{ t('operations.continue') }}</button></form>
<script src="{{ asset('admin-import.js') }}" defer></script>
{% endif %}
{% endif %}

{% if report and report.complete %}
<h2>{{ t('operations.results') }}</h2>
<table><thead><tr><th scope="col">{{ t('operations.col_kind') }}</th><th scope="col">{{ t('operations.col_processed') }}</th>
<th scope="col">{{ t('operations.col_verified') }}</th><th scope="col">{{ t('operations.col_skipped') }}</th>
<th scope="col">{{ t('operations.col_review') }}</th></tr></thead><tbody>
{% for count in report.rows %}<tr><th scope="row">{{ count.label }}</th>
<td>{{ count.processed|format_number }}</td><td>{{ count.verified|format_number }}</td>
<td>{{ (count.skipped ?? 0)|format_number }}</td><td>{{ (count.review ?? 0)|format_number }}</td></tr>{% endfor %}
</tbody></table>
{% if report.estimates is not empty %}<h3>{{ t('operations.col_source') }}</h3>
<ul>{% for total in report.estimates %}<li>{{ total.label }}: {{ total.value|format_number }}</li>{% endfor %}</ul>{% endif %}
<p><a href="{{ report.download|safe_url }}" download>{{ t('operations.download_report') }}</a></p>
<h2>{{ t('operations.publish_heading') }}</h2>
{% if report.published %}<p role="status">{{ t('operations.published') }}</p>{% else %}
<p>{{ t('operations.publish_intro') }}</p>
<form method="post" action="{{ action|safe_url }}" data-admin-progress>
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="job" value="{{ selected.id }}">
<p><label><input type="checkbox" name="activate_members" value="1" checked> {{ t('operations.activate_members') }}</label></p>
<p><label><input type="checkbox" name="confirm_publish" value="1" required> {{ t('operations.confirm_publish') }}</label></p>
<button name="action" value="{{ 'publish' }}">{{ t('operations.publish') }}</button></form>
{% endif %}
{% endif %}

{% if report %}
{% if report.notes is not empty %}<h2>{{ t('operations.reasons') }}</h2>
<p>{{ t('operations.notes_total', {count: report.notes_total, page: report.notes_page, pages: report.notes_pages}) }}</p>
<ul>{% for note in report.notes %}<li>{{ note.kind }} / {{ note.source_id }}: {{ note.label }}</li>{% endfor %}</ul>
<p>{% if report.previous %}<a href="{{ report.previous|safe_url }}">{{ t('operations.notes_previous') }}</a>{% endif %}
{% if report.next %}<a href="{{ report.next|safe_url }}">{{ t('operations.notes_next') }}</a>{% endif %}</p>{% endif %}
<details><summary>{{ t('operations.coverage') }}</summary>
<ul>{% for table in report.coverage %}<li>{{ table.table }}:
{{ table.mapping == 'mapped' or table.mapping == 'core' ? t('operations.mapped') : t('operations.excluded') }}</li>{% endfor %}</ul></details>
{% endif %}

<h2>{{ t('operations.sources') }}</h2>
{% if sources is empty %}<p>{{ t('operations.import_setup') }}</p>{% endif %}
{% for source in sources %}
<section aria-labelledby="source-{{ source.id }}">
<h3 id="source-{{ source.id }}">{{ source.engine }} — {{ source.database }}{% if source.prefix %} ({{ source.prefix }}){% endif %}{% if source.preflight and source.preflight.version %}, {{ source.preflight.version }}{% endif %}</h3>
{% if source.estimates is not empty %}<p>{{ t('operations.estimate') }}:
{% for total in source.estimates %}{{ total.label }} {{ total.value|format_number }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
{% for problem in source.problems %}<p>{{ problem }}</p>{% endfor %}
<form method="post" action="{{ action|safe_url }}" data-admin-progress>
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="source" value="{{ source.id }}">
<p><label><input type="checkbox" name="acknowledged" value="1" required> {{ t('operations.acknowledge') }}</label></p>
<button name="action" value="{{ 'begin' }}">{{ t('operations.begin') }}</button></form>
{% if source.panel %}<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="source" value="{{ source.id }}">
<button name="action" value="{{ 'remove_source' }}">{{ t('operations.remove_source') }}</button></form>{% endif %}
</section>
{% endfor %}

{% if preflight %}
<h3>{{ t('operations.preflight') }}</h3>
{% if preflight.engine %}<p>{{ t('operations.found', {engine: preflight.engine, version: preflight.version ?? '?', prefix: preflight.prefix, charset: preflight.charset ?? '?'}) }}</p>{% endif %}
<ul>{% for message in preflight.messages %}<li{% if message.blocking %} role="alert"{% endif %}>{{ message.text }}</li>{% endfor %}</ul>
{% endif %}

<details{% if sources is empty or preflight %} open{% endif %}><summary>{{ t('operations.source_add') }}</summary>
<p>{{ t('operations.source_intro') }}</p>
<form method="post" action="{{ action|safe_url }}" data-admin-progress autocomplete="off">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<p><label for="import-engine">{{ t('operations.engine') }}</label>
<select id="import-engine" name="engine"><option value="">{{ t('operations.engine_auto') }}</option>
{% for engine in engines %}<option value="{{ engine }}"{% if form.engine == engine %} selected{% endif %}>{{ engine }}</option>{% endfor %}</select></p>
<p><label for="import-host">{{ t('operations.db_host') }}</label>
<input id="import-host" name="host" value="{{ form.host }}" required maxlength="253"></p>
<p><label for="import-port">{{ t('operations.db_port') }}</label>
<input id="import-port" name="port" value="{{ form.port }}" required inputmode="numeric" pattern="[0-9]{1,5}"></p>
<p><label for="import-database">{{ t('operations.db_name') }}</label>
<input id="import-database" name="database" value="{{ form.database ?? '' }}" required maxlength="64"></p>
<p><label for="import-username">{{ t('operations.db_user') }}</label>
<input id="import-username" name="username" value="{{ form.username ?? '' }}" required maxlength="128" autocomplete="off"></p>
<p><label for="import-password">{{ t('operations.db_password') }}</label>
<input id="import-password" name="password" type="password" maxlength="512" autocomplete="new-password"></p>
<p><label for="import-prefix">{{ t('operations.db_prefix') }}</label>
<input id="import-prefix" name="prefix" value="{{ form.prefix ?? '' }}" maxlength="48" pattern="[A-Za-z0-9_]*"></p>
<p><label for="import-charset">{{ t('operations.db_charset') }}</label>
<select id="import-charset" name="charset">{% for charset in charsets %}<option value="{{ charset }}"{% if form.charset == charset %} selected{% endif %}>{{ charset }}</option>{% endfor %}</select></p>
<p><label for="import-attachments">{{ t('operations.attachment_root') }}</label>
<input id="import-attachments" name="attachment_root" value="{{ form.attachment_root ?? '' }}" maxlength="1024"></p>
<h4>{{ t('operations.before_start') }}</h4>
<ul><li>{{ t('operations.before_permissions') }}</li><li>{{ t('operations.before_passwords') }}</li><li>{{ t('operations.before_links') }}</li></ul>
<button name="action" value="{{ 'add_source' }}">{{ t('operations.check_source') }}</button></form>
</details>

<h2>{{ t('operations.recent') }}</h2>
<ul>{% for job in recent %}<li><a href="{{ job.url|safe_url }}">{{ t('operations.open') }} — {{ job.engine }} {{ job.source_version }}</a>{% if job.published_at %} ({{ t('operations.published') }}){% endif %}</li>{% endfor %}</ul>
{% endblock %}
