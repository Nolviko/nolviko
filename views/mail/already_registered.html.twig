{# Notice to an existing account, HTML (M02.03). Context: name, login_url, resend_url, subject, language. Extends mail/layout.html.twig (design pass 2026-11-07). #}
{% extends 'mail/layout.html.twig' %}
{% block body %}
<p style="margin:0 0 14px;">{{ t('mail.already_registered.greeting', {name: name}) }}</p>
<p style="margin:0 0 14px;">{{ t('mail.already_registered.body') }}</p>
<p style="margin:0 0 14px;">{{ t('mail.already_registered.login') }} <a href="{{ login_url|safe_url }}" style="color:#0a6e5c;word-break:break-all;">{{ login_url }}</a></p>
<p style="margin:0 0 14px;">{{ t('mail.already_registered.resend') }} <a href="{{ resend_url|safe_url }}" style="color:#0a6e5c;word-break:break-all;">{{ resend_url }}</a></p>
<p style="margin:0 0 14px;color:#414f48;font-size:14px;">{{ t('mail.already_registered.not_you') }}</p>
{% endblock %}
