{# Composer. Beta 17 G1: several recipients (comma-separated, up to max_recipients with the hidden ones), hidden
   recipients, server-side drafts (draft = the draft being continued; "Save draft" posts intent = draft_intent). #}
{% extends 'layouts/page.twig' %}
{% block main_class %}{{ 'main-medium' }}{% endblock %}
{% block content %}
<h1>{{ t('conversations.new') }}</h1>
<nav class="crumb" aria-label="{{ t('core.nav.breadcrumb') }}"><a href="{{ index_url|safe_url }}">{{ t('conversations.back') }}</a> · <a href="{{ drafts_url|safe_url }}">{{ t('conversations.drafts') }}</a></nav>
<p class="lead">{{ t('conversations.policy') }}</p>
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if notice|default(null) %}<p role="status" class="alert alert-info">{{ notice }}</p>{% endif %}
{% if preview|default(null) %}<section class="card post-preview" aria-labelledby="post-preview-heading"><h2 id="post-preview-heading">{{ t('threads.preview.heading') }}</h2><div class="post-body" dir="auto">{{ preview }}</div></section>{% endif %}
<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
{% if draft %}<input type="hidden" name="draft" value="{{ draft }}">{% endif %}
<p><label for="recipient">{{ t('conversations.recipients') }}</label>
<input id="recipient" name="recipient" value="{{ recipient }}" maxlength="1000" autocomplete="off" dir="auto" data-autocomplete="members" data-multiple aria-describedby="recipient-hint">
<small id="recipient-hint">{{ t('conversations.recipients_hint', {limit: max_recipients}) }}</small></p>
<p><label for="hidden-recipients">{{ t('conversations.hidden_recipients') }}</label>
<input id="hidden-recipients" name="hidden_recipients" value="{{ hidden_recipients }}" maxlength="1000" autocomplete="off" dir="auto" data-autocomplete="members" data-multiple aria-describedby="hidden-hint">
<small id="hidden-hint">{{ t('conversations.hidden_hint') }}</small></p>
<p><label for="subject">{{ t('conversations.subject') }}</label>
<input id="subject" name="subject" value="{{ subject }}" required maxlength="160" dir="auto"></p>
<p><label for="message">{{ t('conversations.message') }}</label>
{% include 'components/editor_toolbar.twig' with {target: 'message'} only %}
<textarea id="message" data-mentions name="content" required maxlength="8000" rows="8" dir="auto">{{ content }}</textarea></p>
<p><button>{{ t('conversations.send') }}</button>
<button class="btn-s" type="submit" name="intent" value="{{ draft_intent }}" formnovalidate>{{ t('conversations.draft_save') }}</button>
<button class="btn-s" type="submit" name="intent" value="{{ preview_intent }}" formnovalidate>{{ t('threads.preview.button') }}</button></p>
</form>
{% endblock %}
