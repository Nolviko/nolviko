{# Inline thread tools on the thread page (design pass 2026-11-07; bookmark/follow moved into the thread tools menu
   2026-11-27): accepted answer link
   and the poll (vote form until the reader voted or the poll closed, results otherwise). Context: tools
   (CommunityRead::threadTools), thread_id, csrf_field and csrf_token (null for guests: no forms then). Poll creation
   and attachments stay on the community tools page. Every form posts to the community endpoint and returns here. #}
{% set act = path('community', {section: 'thread'}) ~ '?thread=' ~ thread_id %}
{% set member = csrf_token is not null %}
{% if tools.solution %}<p class="thread-tools"><a class="chip chip-new" href="{{ path('posts.show', {post: tools.solution})|safe_url }}">{{ t('community.solution') }}</a></p>
{% endif %}
{% if tools.poll %}
{% set total = 0 %}{% for option in tools.options %}{% set total = total + option.votes %}{% endfor %}
<section class="card poll" aria-labelledby="poll-question">
<h2 id="poll-question" dir="auto">{{ tools.poll.question }}</h2>
{% if member and not tools.relationship.voted and not tools.poll_closed %}
<form method="post" action="{{ act|safe_url }}"><input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="action" value="{{ 'vote' }}"><input type="hidden" name="target" value="{{ thread_id }}"><input type="hidden" name="return_thread" value="{{ thread_id }}">
<fieldset aria-labelledby="poll-question">
{% for option in tools.options %}
<p><label><input type="{{ tools.poll.multiple_choice ? 'checkbox' : 'radio' }}" name="options[]" value="{{ option.id }}"> <bdi>{{ option.label }}</bdi></label></p>
{% endfor %}</fieldset>
{% if tools.poll.imported_max_choices|default(null) %}<p class="meta">{{ t('operations.poll_limit', {count: tools.poll.imported_max_choices}) }}</p>{% endif %}
<p><button>{{ t('community.vote') }}</button></p></form>
{% else %}
<ul class="poll-results">
{% for option in tools.options %}
<li><span class="row"><bdi>{{ option.label }}</bdi>{% if tools.poll_results_visible %}<span class="meta row-end">{{ option.votes|format_number }}</span>{% endif %}</span>
{% if tools.poll_results_visible %}<progress max="{{ max(total, 1) }}" value="{{ option.votes }}" aria-hidden="true"></progress>{% endif %}</li>
{% endfor %}
</ul>
{% if not tools.poll_results_visible %}<p class="meta">{{ t('operations.poll_results_hidden') }}</p>{% endif %}
{% endif %}
{% if member and tools.relationship.voted and tools.poll.allow_change|default(0) and not tools.poll_closed %}<form method="post" action="{{ act|safe_url }}"><input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
<input type="hidden" name="action" value="{{ 'vote_retract' }}"><input type="hidden" name="target" value="{{ thread_id }}"><input type="hidden" name="return_thread" value="{{ thread_id }}">
<button class="btn-s">{{ t('community.retract_vote') }}</button></form>{% endif %}
{% if tools.poll_closed %}<p class="meta">{{ t('operations.poll_locked') }}</p>{% endif %}
</section>
{% endif %}
