{# Installer step 2 (M01.14). Context: language, title, action, csrf_field, csrf_token, needs_code, code_file,
   storage_ready, values {driver, host, port, name, user}, errors (translated). The password is never filled in. #}
{% extends 'layouts/page.twig' %}

{% block main_class %}{{ 'main-install' }}{% endblock %}
{% block header %}<header class="top"><div class="top-in"><span class="wm"><span class="mark" aria-hidden="true">n</span>{{ 'nolviko' }}</span></div></header>{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<h1>{{ title }}</h1>
{% include 'installer/steps.twig' with {step: 2} %}
<h2>{{ t('installer.database.heading') }}</h2>

{% if errors is not empty %}
<div role="alert">
<p>{{ t('installer.form.errors') }}</p>
<ul>
{% for error in errors %}
<li>{{ error }}</li>
{% endfor %}
</ul>
</div>
{% endif %}

{% if not storage_ready %}
<p role="alert">{{ t('diagnostics.storage_not_writable') }}</p>
{% endif %}

<form method="post" action="{{ action|safe_url }}">
<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
{% if needs_code %}
<p id="setup-code-help">{{ t('installer.setup_code.help', {file: code_file}) }}</p>
<p><label for="setup-code">{{ t('installer.setup_code.label') }}</label>
<input id="setup-code" name="setup_code" type="text" required autocomplete="off" spellcheck="false" aria-describedby="setup-code-help"></p>
{% endif %}
<p><label for="db-driver">{{ t('installer.database.driver') }}</label>
<select id="db-driver" name="driver" aria-describedby="db-driver-help">
<option value="{{ 'mysql' }}"{% if values.driver|default('') != 'postgresql' %} selected{% endif %}>{{ t('installer.database.driver_mysql') }}</option>
<option value="{{ 'postgresql' }}"{% if values.driver|default('') == 'postgresql' %} selected{% endif %}>{{ t('installer.database.driver_postgresql') }}</option>
</select>
<span id="db-driver-help">{{ t('installer.database.driver_help') }}</span></p>
<p><label for="db-host">{{ t('installer.database.host') }}</label>
<input id="db-host" name="host" type="text" required value="{{ values.host }}" autocomplete="off"></p>
<p><label for="db-port">{{ t('installer.database.port') }}</label>
<input id="db-port" name="port" type="text" inputmode="numeric" value="{{ values.port }}" autocomplete="off" aria-describedby="db-port-help">
<span id="db-port-help">{{ t('installer.database.port_help') }}</span></p>
<p><label for="db-name">{{ t('installer.database.name') }}</label>
<input id="db-name" name="name" type="text" required value="{{ values.name }}" autocomplete="off"></p>
<p><label for="db-user">{{ t('installer.database.user') }}</label>
<input id="db-user" name="user" type="text" required value="{{ values.user }}" autocomplete="off"></p>
<p><label for="db-password">{{ t('installer.database.password') }}</label>
<input id="db-password" name="password" type="password" autocomplete="new-password"></p>
<p><button type="submit">{{ t('installer.database.submit') }}</button></p>
</form>
{% endblock %}
