<?xml version="1.0"?>
<ruleset name="Nolviko">
    <description>PSR-12 for maintained first-party PHP; frozen research snapshots retain their evidence hashes.</description>
    <arg name="extensions" value="php"/>
    <arg name="encoding" value="utf-8"/>
    <arg name="basepath" value="."/>
    <arg value="s"/>
    <file>src</file>
    <file>config</file>
    <file>translations</file>
    <file>tests</file>
    <file>tools</file>
    <file>docker</file>
    <file>public</file>
    <rule ref="PSR12"/>
    <rule ref="Generic.Formatting.DisallowMultipleStatements"/>

    <!-- Readability rules beyond PSR-12 for app/ code (M01.01d). Research helpers keep their recorded hashes. -->
    <rule ref="Generic.PHP.RequireStrictTypes">
        <exclude-pattern>*/research/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax">
        <exclude-pattern>*/research/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.WhiteSpace.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
        <exclude-pattern>*/research/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Strings.ConcatenationSpacing">
        <properties>
            <property name="spacing" value="1"/>
            <property name="ignoreNewlines" value="true"/>
        </properties>
        <exclude-pattern>*/research/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
        <exclude-pattern>*/research/*</exclude-pattern>
    </rule>
</ruleset>
